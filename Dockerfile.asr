FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir faster-whisper==1.0.3 fastapi uvicorn

ENV MODEL_SIZE=small
ENV COMPUTE_TYPE=int8_float16

EXPOSE 8000

CMD ["uvicorn", "services.asr.whisper_worker:app", "--host", "0.0.0.0", "--port", "8000"]
