FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir torch torchaudio fastapi uvicorn scipy

EXPOSE 8000

CMD ["uvicorn", "services.tts.indic_tts_worker:app", "--host", "0.0.0.0", "--port", "8000"]
