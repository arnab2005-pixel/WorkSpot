    "@workspot/shared": "workspace:*",
    "fastify": "^5.2.1",
    "mongodb": "^6.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
