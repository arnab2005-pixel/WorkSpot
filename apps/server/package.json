{
  "name": "@workspot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
  "dev": "tsx watch src/index.ts",
  "build": "tsc --outDir dist --module NodeNext --moduleResolution NodeNext",
